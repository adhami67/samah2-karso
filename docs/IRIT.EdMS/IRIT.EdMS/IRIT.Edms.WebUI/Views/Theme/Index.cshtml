@model IRIT.EdMS.Common.ViewModel.ThemeViewModel
@{
    ViewBag.Title = "تنظیمات پوسته";

}

@using (Html.BeginForm())
{
    @(Html.Kendo().TabStrip().Name("Skin").Animation(animation =>
             {
                 animation.Enable(true);
                 animation.Open(config =>
                     {
                         config.Fade(FadeDirection.In);
                         config.Duration(AnimationDuration.Fast);
                     });
             }).Items(tabstrip =>
                 {
                     tabstrip.Add().Text("تنظیمات افکت های نمایشی")
                         .Content(@<text>
                    <div class="editor-field">@Html.CheckBoxFor(c => c.StartEffect)@Html.LabelFor(c => c.StartEffect)</div>
                    <div class="label-field">@Html.LabelFor(c => c.Theme)</div>
                    <div class="editor-field">
                        @Html.Kendo().DropDownListFor(c => c.Theme).BindTo(new SelectList(Model.ThemeList, "Value", "Text"))
                    </div>
                    <div class="k-rtl" style="padding: 5px 0;">
                        @Html.Kendo().Button().Name("Ok").Content("ذخیره شود")
                    </div>
                        </text>);
                 }).SelectedIndex(0)
    )
}
