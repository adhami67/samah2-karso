@using System.Globalization
@model DateTime?
@{
    var name = this.ViewContext.ViewData.ModelMetadata.PropertyName;
    var value = string.Empty;
    if (Model != null)
    {
        var dateTime = new DateTime(Model.Value.Year, Model.Value.Month, Model.Value.Day, new GregorianCalendar());
        var persianCalendar = new PersianCalendar();

        value = persianCalendar.GetYear(dateTime) + "/" +
                    persianCalendar.GetMonth(dateTime).ToString("00") + "/" +
                    persianCalendar.GetDayOfMonth(dateTime).ToString("00");
    }
}

<input type ="text" id="datepicker" name="@name" class="form-control" value="@value" dir="ltr" style="width: 100%" />

<script>
    $(document).ready(function () {
        $("#datepicker").kendoDatePicker();
    });
</script>


