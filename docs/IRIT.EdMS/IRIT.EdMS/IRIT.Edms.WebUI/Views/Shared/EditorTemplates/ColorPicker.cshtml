@{
    Layout = null;
}


@using System.Data.Entity.Migrations.Sql
@model string

@{
    var name = this.ViewContext.ViewData.ModelMetadata.PropertyName;
    var value = string.IsNullOrEmpty(Model) ? string.Empty : Model;
}

@(Html.Kendo().ColorPicker()
                .Name(@name)
                .Value(@value)
                .Messages(msg => msg.Apply(GeneralResource.Ok))
                .Messages(msg => msg.Cancel(GeneralResource.Cancel))
)

