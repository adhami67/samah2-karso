<div class="container">



    <div id='calendar' style="width:100%"></div>

</div>


<div id="popupEventForm" class="modal hide" style="display: none;">
    <div class="modal-header"><h3>افزودن رویداد جدید</h3></div>
    <div class="modal-body">
        <form id="EventForm" class="well">
            <input type="hidden" id="eventID">
            <label>عنوان رویداد</label>
            <input type="text" id="eventTitle" placeholder="Title here"><br />
            <label>تاریخ رویداد</label>
            <input type="text" id="eventDate"><br />
            <label>ساعت رویداد</label>
            <input type="text" id="eventTime"><br />
            <label>  مدت زمان قرار ملاقات به دقیقه </label>
            <input type="text" id="eventDuration" placeholder="15"><br />
        </form>
    </div>
    <div class="modal-footer">
        <button type="button" id="btnPopupCancel" data-dismiss="modal" class="btn">لغو</button>
        <button type="button" id="btnPopupSave" data-dismiss="modal" class="btn btn-primary">ذخیره رویداد</button>
    </div>
</div>







