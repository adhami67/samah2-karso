
@{
    ViewBag.Title =GeneralResource.Employees;
}


@Styles.Render("~/Content/bootstrap-dialog")

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-5" style="padding-bottom: 10px;">
                <a href="@Url.Action(MVC.HumanResource.Employee.ActionNames.Create, MVC.HumanResource.Employee.Name)" class="btn btn-success">
                    <i class="fa fa-lg fa-plus"></i> @GeneralResource.New
                </a>
            </div>
        </div>

        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-lg fa-users"></i> @GeneralResource.EmployeesList
            </div>
            <div class="k-rtl">
                @(Html.Kendo().Grid<IRIT.EdMS.HumanResource.Model.ViewModel.Employee.EmployeeViewModel>().Name("grid_Party")
                   .Columns(columns =>
                   {
                       columns.Bound(c => c.FirstName).Width(150);
                       columns.Bound(c => c.LastName).Width(160);
                       columns.Bound(c => c.EmploymentNumber).Width(160);
                       columns.Template(x => { }).ClientTemplate(
                          "<a class='btn btn-warning' href='" + Url.Action(MVC.HumanResource.Employee.ActionNames.Edit, MVC.HumanResource.Employee.Name) + "?id=#= ID #'" + ">" + GeneralResource.Edit + "</a>" +
                          "<a class='btn-danger btn' target='#= ID #'>" + GeneralResource.Delete + "</a>");
                   })
                   .HtmlAttributes(new { style = "height: 480px;" })
                   .Scrollable()
                   .Sortable()
                   .Filterable(flt =>
                   {
                       flt.Mode(GridFilterMode.Row);
                       flt.Operators(fltOpt =>
                       {
                           fltOpt.ForString(fms => { fms.IsEqualTo(GeneralResource.EqualsTo); fms.IsNotEqualTo(GeneralResource.IsNotEqualTo); fms.StartsWith(GeneralResource.StartsWith); fms.EndsWith(GeneralResource.EndsWith); fms.Contains(GeneralResource.Contains); fms.DoesNotContain(GeneralResource.DoesNotContain); });
                           //fltOpt.ForDate(fms => { fms.IsEqualTo(GeneralResource.Equals); fms.IsNotEqualTo(GeneralResource.IsNotEqualTo); fms.StartsWith(GeneralResource.StartsWith); fms.EndsWith(GeneralResource.EndsWith); fms.Contains(GeneralResource.Contains); fms.DoesNotContain(GeneralResource.DoesNotContain); });
                       });
                   })
                   .Groupable(grp => { grp.Messages(gmsg => { gmsg.Empty(GeneralResource.DragColumnToGroup); }); })
                   .Pageable(pageable => pageable.Refresh(true).PageSizes(true).ButtonCount(5).Messages(msg => { msg.Display(GeneralResource.GridPagingMessage); msg.ItemsPerPage(GeneralResource.ItemsPerPage); msg.Refresh(GeneralResource.Refresh); msg.Last(GeneralResource.Last); msg.Next(GeneralResource.Next); msg.Previous(GeneralResource.Previous); msg.First(GeneralResource.First); }))
                   .DataSource(dataBinding => dataBinding.Ajax().Model(model => model.Id(id => id.Id))
                   .Read(read => read.Action(MVC.HumanResource.Employee.ActionNames.Employee_Read, MVC.HumanResource.Employee.Name)))
                )
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).on('click', '.btn-danger', function () {
            var rowToDelete = $(this).closest("tr");
            var grid = $("#grid_userGroup").data("kendoGrid");

            var pkNo = $(this).attr("target");
            var rowNo = '#row-' + pkNo;
            BootstrapDialog.show({
                title: '',
                message: 'آیا از حذف رکورد مورد نظر اطمینان دارید؟',
                buttons: [{
                    label: 'بلی',
                    action: function (dialog) {
                        $.ajax({
                            type: "POST",
                            url: "@Url.Action(MVC.HumanResource.Employee.ActionNames.Delete, MVC.HumanResource.Employee.Name)",
                            data: { id: pkNo },
                            cache: false,
                            dataType: "json",
                            success: function () {
                                dialog.close();
                                grid.removeRow(rowToDelete);
                            },
                            error: function (jqXHR, exception) {
                                alert('Uncaught Error.\n' + jqXHR.responseText);
                            }
                        });
                    }
                }, {
                    label: 'خیر',
                    action: function (dialog) {
                        dialog.close();
                    }
                }]
            });
        });
    </script>
}