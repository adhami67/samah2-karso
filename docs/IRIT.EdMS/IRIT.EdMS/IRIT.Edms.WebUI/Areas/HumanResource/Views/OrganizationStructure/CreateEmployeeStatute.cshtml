@using IRIT.Framework.Utility.Helpers
@model IRIT.EdMS.HumanResource.Model.ViewModel.EmployeeStatute.EmployeeStatuteViewModel

@{
    ViewBag.Title = GeneralResource.AddEmployeeStatute;
}

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(MVC.HumanResource.OrganizationStructure.ActionNames.CreateEmployeeStatute, MVC.HumanResource.OrganizationStructure.Name, new { area = MVC.HumanResource.Name }, FormMethod.Post, new { User = "form", @class = "form-horizontal", autocomplete = "off", id = "createOrganizationForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => Model.OrganizationStructureId)
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>@GeneralResource.Specifications</strong>
                </div>
                <div class="panel-body">
                    <div class="tab-content">
                        <div class="tab-pane active" style="padding-top:10px;" id="requiredInfo">
                            <div class="form-group">
                                @Html.LabelFor(m => m.EmployeeId, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(m => m.EmployeeId, (SelectList)ViewBag.Employees, string.Empty, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.EmployeeId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.ApplyDate, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.EditorFor(m => m.ApplyDate, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.ApplyDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.Comment, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.Comment)
                                    @Html.ValidationMessageFor(m => m.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="@Url.Action(MVC.HumanResource.OrganizationStructure.ActionNames.Index, MVC.HumanResource.OrganizationStructure.Name)" class="btn btn-danger">
                                <i class="fa fa-lg fa-arrow-right"></i> @GeneralResource.Back
                            </a>
                            <button type="submit" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i> @GeneralResource.Save
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            warningBeforeLoad();
        });
    </script>
}
