@model IRIT.EdMS.Workflow.Model.ViewModel.WorkType.WorkTypeViewModel

@using IRIT.Framework.Resources
@using IRIT.Framework.Utility.Helpers
@{
    ViewBag.Title = GeneralResource.AddWorkType;
}
<link href="~/Content/jasny/jasny-bootstrap.min.css" rel="stylesheet" />
<script src="~/Scripts/jasny/jasny-bootstrap.min.js"></script>
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(MVC.Workflow.WorkType.ActionNames.Create, MVC.Workflow.WorkType.Name, new { area = MVC.Workflow.Name }, FormMethod.Post, new { User = "form", @class = "form-horizontal", autocomplete = "off", id = "createUserForm" }))
        {
            @Html.AntiForgeryToken()
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>@GeneralResource.Specifications</strong>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="fileinput fileinput-new" style="padding-right:250px" data-provides="fileinput">

                                <div class="fileinput-new thumbnail" style="width: 50px; height: 50px;">
                                    <img src="http://placehold.it/860x600/e0e0e0" alt="...">
                                </div>
                                <div class="fileinput-preview fileinput-exists thumbnail" style="max-width: 255px; max-height: 180px;"></div>
                                <div>
                                    <span class="btn btn-default btn-file">
                                        <span class="fileinput-new">@GeneralResource.SelectPhoto</span><span class="fileinput-exists">@GeneralResource.ChangeImage</span>
                                        @Html.TextBoxFor(m => m.Image, new { type = "file" })
                                        @*<input type="file" name="partyImage" id="partyImage">*@
                                    </span>
                                    <a href="#" class="btn btn-default fileinput-exists" data-dismiss="fileinput">@GeneralResource.Clear</a>
                                </div>

                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.WorkTypeTitle, new { @class = "col-md-5 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.WorkTypeTitle)
                                    @Html.ValidationMessageFor(m => m.WorkTypeTitle, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.WorkTypeCode, new { @class = "col-md-5 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.WorkTypeCode)
                                    @Html.ValidationMessageFor(m => m.WorkTypeCode, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.WorkTypeColor, new {@class = "col-md-5 control-label"})
                                <div class="col-md-6">
                                    @Html.EditorFor(m => m.WorkTypeColor)
                                    @Html.ValidationMessageFor(m => m.WorkTypeColor, "", new {@class = "text-danger"})
                                </div>
                            </div>
                           
                            <div class="form-group">
                                @Html.LabelFor(m => m.Comment, new { @class = "col-md-5 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.Comment)
                                    @Html.ValidationMessageFor(m => m.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="@Url.Action(MVC.Common.InfraStructureRing.ActionNames.Index, MVC.Common.InfraStructureRing.Name)" class="btn btn-danger">
                                <i class="fa fa-lg fa-arrow-right"></i> @GeneralResource.Back
                            </a>
                            <button type="submit" value="Create" name="action:Create" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i> @GeneralResource.Save

                            </button>
                            <button type="submit" value="Create_new" name="action:Create_new" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i>  @GeneralResource.SaveNew

                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
