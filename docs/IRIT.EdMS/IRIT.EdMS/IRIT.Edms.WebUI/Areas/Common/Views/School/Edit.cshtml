@model IRIT.EdMS.Common.Model.ViewModel.School.SchoolViewModel

@using IRIT.Framework.Utility.Helpers
@{
    ViewBag.Title = GeneralResource.EditSchool;
    var imgSrc = "http://placehold.it/860x600/e0e0e0";
    if (Model.ImageByte != null)
    {
        var base64 = Convert.ToBase64String(Model.ImageByte);
        imgSrc = string.Format("data:image/gif;base64,{0}", base64);
    }
}
<link href="~/Content/jasny/jasny-bootstrap.min.css" rel="stylesheet" />
<script src="~/Scripts/jasny/jasny-bootstrap.min.js"></script>

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(MVC.Common.School.ActionNames.Edit, MVC.Common.School.Name, new { area = MVC.Common.Name }, FormMethod.Post, new { User = "form", @class = "form-horizontal", autocomplete = "off", id = "createUserForm", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>@GeneralResource.Specifications</strong>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="fileinput fileinput-new" style="padding-right:142px" data-provides="fileinput">
                                <div class="fileinput-new thumbnail" style="width: 255px; height: 180px;">
                                    <img src="http://placehold.it/860x600/e0e0e0" alt="...">
                                </div>
                                <div class="fileinput-preview fileinput-exists thumbnail" style="max-width: 255px; max-height: 180px;"></div>
                                <div>
                                    <span class="btn btn-default btn-file">
                                        <span class="fileinput-new">@GeneralResource.SelectPhoto</span><span class="fileinput-exists">@GeneralResource.ChangeImage</span>
                                        @Html.TextBoxFor(m => m.Image, new { type = "file" })
                                        @*<input type="file" name="partyImage" id="partyImage">*@
                                    </span>
                                    <a href="#" class="btn btn-default fileinput-exists" data-dismiss="fileinput">@GeneralResource.Clear</a>
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.SchoolName, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.SchoolName)
                                    @Html.ValidationMessageFor(m => m.SchoolName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.SchoolsGroupId, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.DropDownListFor(m => m.SchoolsGroupId, (SelectList)ViewBag.SchoolGroups, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.SchoolsGroupId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.GradeKindId, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.DropDownListFor(m => m.GradeKindId, (SelectList)ViewBag.GradeKinds, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.GradeKindId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.GenderKindId, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.DropDownListFor(m => m.GenderKindId, (SelectList)ViewBag.Genders, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.GenderKindId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Code, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.Code)
                                    @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.IssueYear, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.EditorFor(m => m.IssueYear)
                                    @Html.ValidationMessageFor(m => m.IssueYear, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.PostAddress, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.PostAddress, new { @class = "form-control", autocomplete = "off", @maxlength = "10" })
                                    @Html.ValidationMessageFor(m => m.PostAddress, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.FaxNo, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.FaxNo)
                                    @Html.ValidationMessageFor(m => m.FaxNo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.MobileNo, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.MobileNo, new { @class = "form-control", autocomplete = "off", @maxlength = "11" })
                                    @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.PhoneNo, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.PhoneNo, new { @class = "form-control", autocomplete = "off", @maxlength = "11" })
                                    @Html.ValidationMessageFor(m => m.PhoneNo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.Email, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.Email, new { @class = "form-control", autocomplete = "off", @maxlength = "11" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.Comment, new { @class = "col-md-3 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.Comment)
                                    @Html.ValidationMessageFor(m => m.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="@Url.Action(MVC.Common.School.ActionNames.Index, MVC.Common.School.Name)" class="btn btn-danger">
                                <i class="fa fa-lg fa-arrow-right"></i> @GeneralResource.Back
                            </a>
                            <button type="submit" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i>  @GeneralResource.Save
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function() {
        });
    </script>
}
