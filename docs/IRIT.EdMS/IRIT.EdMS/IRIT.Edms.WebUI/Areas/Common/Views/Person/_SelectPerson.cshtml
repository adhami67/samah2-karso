<div class="row">
    <div class="col-md-5 col-sm-8 col-xs-9 bhoechie-tab-container">
        <div class="col-lg-2 col-md-3 col-sm-3 col-xs-3 bhoechie-tab-menu">
            <div class="list-group">
                <a href="#" class="list-group-item active text-center">
                    <h4 class="glyphicon glyphicon-align-right"></h4><br />@GeneralResource.OrganizationStructure
                </a>
                <a href="#" class="list-group-item text-center">
                    <h4 class="fa fa-lg fa-user"></h4><br />@GeneralResource.EmployeesList
                </a>
                <a href="#" class="list-group-item text-center">
                    <h4 class="fa fa-lg fa-users"></h4><br />@GeneralResource.StudentsList
                </a>
                <a href="#" class="list-group-item text-center">
                    <h4 class="fa fa-lg fa-send"></h4><br />@GeneralResource.Parents
                </a>
            </div>
        </div>
        <div class="col-lg-10 col-md-9 col-sm-9 col-xs-9 bhoechie-tab">
            <div class="bhoechie-tab-content active">
                <div class="k-rtl">
                    @(Html.Kendo().TreeView()
                           .Name("OrganizationStructureTree")
                           .ExpandAll(true)
                           .Checkboxes(checkboxes => checkboxes
                                                       .Name("checkedFiles")
                                                       .CheckChildren(true))
                           .HtmlAttributes(new { style = "height: 395px; " })
                           .BindTo((IEnumerable<TreeViewItemModel>)ViewBag.OrganizationStructureData)
                           .Events(ev => ev.Check("onCheck"))
                    )
                </div>
            </div>
            <div class="bhoechie-tab-content">
                <div class="k-rtl">
                    @(Html.Kendo().Grid<IRIT.EdMS.HumanResource.ViewModel.Employee.EmployeeViewModel>().Name("grid_Party")
                   .Columns(columns =>
                   {
                       columns.Bound(c => c.FullName).Width(220);
                       columns.Command(cmd => cmd.Custom("SelectRow").Text("انتخاب"));
                   })
                   .HtmlAttributes(new { style = "margin-top: -10px" })
                   .Scrollable()
                   .Sortable()
                   .Filterable(flt =>
                   {
                       flt.Mode(GridFilterMode.Row);
                       flt.Operators(fltOpt => { fltOpt.ForString(fms => { fms.IsEqualTo(GeneralResource.EqualsTo); fms.IsNotEqualTo(GeneralResource.IsNotEqualTo); fms.StartsWith(GeneralResource.StartsWith); fms.EndsWith(GeneralResource.EndsWith); fms.Contains(GeneralResource.Contains); fms.DoesNotContain(GeneralResource.DoesNotContain); }); });
                   })
                   .Pageable(pageable => pageable.ButtonCount(5).Messages(msg => { msg.Display(GeneralResource.GridPagingMessage); msg.ItemsPerPage(GeneralResource.ItemsPerPage); msg.Refresh(GeneralResource.Refresh); msg.Last(GeneralResource.Last); msg.Next(GeneralResource.Next); msg.Previous(GeneralResource.Previous); msg.First(GeneralResource.First); msg.Empty(GeneralResource.NoItemToDisplay); }))
                   .DataSource(dataBinding => dataBinding.Ajax().Model(model => model.Id(id => id.ID))
                   .Read(read => read.Action(MVC.Common.Person.ActionNames.Employee_Read, MVC.Common.Person.Name)))
                    )
                </div>
            </div>
            <div class="bhoechie-tab-content">
                <center>
                    <h2 style="margin-top: 0; color: #16a085">@GeneralResource.StudentsList</h2>
                    <br/>
                    <h2>بعدا پیاده سازی می شود</h2>
                </center>
            </div>
            <div class="bhoechie-tab-content">
                <center>
                    <h2 style="margin-top: 0; color: #16a085">@GeneralResource.Parents</h2>
                    <br />
                    <h2>بعدا پیاده سازی می شود</h2>
                </center>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-8 col-xs-9">
        <div style="max-height: 395px; overflow: auto; margin-top: -15px">
            <ul class="list-group checked-list-box" id="selectList">
                <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove" style="color :tomato"></i></a> رضا دودانگی</li>
                <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove" style="color :tomato"></i></a> علی خیر اندیش</li>
                <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove" style="color :tomato"></i></a> رضا دودانگی</li>
                <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove" style="color :tomato"></i></a> رضا دودانگی</li>
                <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove" style="color :tomato"></i></a> رضا دودانگی</li>
                <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove" style="color :tomato"></i></a> رضا دودانگی</li>
                <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove" style="color :tomato"></i></a> رضا دودانگی</li>
                <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove" style="color :tomato"></i></a> رضا دودانگی</li>
                @*<li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove"></i></a> رضا دودانگی</li>
                    <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove"></i></a> رضا دودانگی</li>
                    <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove"></i></a> رضا دودانگی</li>
                    <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove"></i></a> رضا دودانگی</li>
                    <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove"></i></a> رضا دودانگی</li>
                    <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove"></i></a> رضا دودانگی</li>
                    <li class="list-group-item"><a style="cursor: pointer"><i class="fa fa-lg fa-remove"></i></a> رضا دودانگی</li>*@
            </ul>
        </div>
    </div>
</div>
