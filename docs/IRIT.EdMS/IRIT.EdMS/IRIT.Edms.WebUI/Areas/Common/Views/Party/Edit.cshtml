@model IRIT.EdMS.Common.Model.ViewModel.Party.PartyViewModel

@using IRIT.EdMS.WebUI.RazorHelpers
@using IRIT.Framework.Utility.Helpers
@{
    ViewBag.Title = GeneralResource.EditPerson;
    var imgSrc = "http://placehold.it/860x600/e0e0e0";
    if (Model.ImageByte != null)
    {
        var base64 = Convert.ToBase64String(Model.ImageByte);
        imgSrc = string.Format("data:image/gif;base64,{0}", base64);
    }
}

<link href="~/Content/jasny/jasny-bootstrap.min.css" rel="stylesheet" />
<script src="~/Scripts/jasny/jasny-bootstrap.min.js"></script>
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(MVC.Common.Party.ActionNames.Edit, MVC.Common.Party.Name, new { area = MVC.Common.Name }, FormMethod.Post, new { User = "form", @class = "form-horizontal", autocomplete = "off", id = "createUserForm", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(c => c.Id)
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>@GeneralResource.Specifications</strong>
                </div>
                <div class="panel-body">
                    <ul class="nav nav-tabs">
                        <li class="active">
                            <a href="#requiredInfo" data-toggle="tab">@GeneralResource.personal_Information</a>
                        </li>
                        <li>
                            <a href="#addresses" data-toggle="tab">@GeneralResource.Contact_Information</a>
                        </li>
                        <li>
                            <a href="#partyOwners" data-toggle="tab">@GeneralResource.Access</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane active" style="padding-top: 20px;" id="requiredInfo">
                            <div class="col-md-6">
                                <div class="fileinput fileinput-new" style="padding-right:142px" data-provides="fileinput">
                                    <div class="fileinput-new thumbnail" style="width: 255px; height: 180px;">
                                        <img src="@imgSrc" alt="...">
                                    </div>
                                    <div class="fileinput-preview fileinput-exists thumbnail" style="max-width: 255px; max-height: 180px;"></div>
                                    <div>
                                        <span class="btn btn-default btn-file">
                                            <span class="fileinput-new">@GeneralResource.SelectPhoto</span><span class="fileinput-exists">@GeneralResource.ChangeImage</span>
                                            @Html.TextBoxFor(m => m.Image, new { type = "file" })
                                            @*<input type="file" name="partyImage" id="partyImage">*@
                                        </span>
                                        <a href="#" class="btn btn-default fileinput-exists" data-dismiss="fileinput">@GeneralResource.Clear</a>
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.FirstName, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.FirstName)
                                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.LastName, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.LastName)
                                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.NickName, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.NickName)
                                        @Html.ValidationMessageFor(m => m.NickName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.FatherName, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.FatherName)
                                        @Html.ValidationMessageFor(m => m.FatherName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.NationalCode, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.NationalCode, new { @class = "form-control", autocomplete = "off", @maxlength = "10" })
                                        @Html.ValidationMessageFor(m => m.NationalCode, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.IdNumber, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.IdNumber)
                                        @Html.ValidationMessageFor(m => m.IdNumber, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group" style="padding-top: 20px">
                                    @Html.LabelFor(m => m.IdSerial, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.IdSerial)
                                        @Html.ValidationMessageFor(m => m.IdSerial, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Nationality, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(m => m.Nationality, (SelectList)ViewBag.Nationalitys, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Nationality, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Gender, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(m => m.Gender, (SelectList)ViewBag.Genders, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.BirthDate, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.EditorFor(m => m.BirthDate, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.BirthDate, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.BirthPlaceCountryId, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(m => m.BirthPlaceCountryId, (SelectList)ViewBag.BirthDateNationalitys, new { @class = "form-control", id = "ddlBirthPlaceCountry" })
                                        @Html.ValidationMessageFor(m => m.BirthPlaceCountryId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.BirthPlaceProvinceId, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(m => m.BirthPlaceProvinceId, (SelectList)ViewBag.Provinces, new { @class = "form-control", id = "ddlBirthPlaceProvince" })
                                        @Html.ValidationMessageFor(m => m.BirthPlaceProvinceId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.BirthPlaceCityId, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(m => m.BirthPlaceCityId, (SelectList)ViewBag.Citys, new { @class = "form-control", id = "ddlBirthPlaceCity" })
                                        @Html.ValidationMessageFor(m => m.BirthPlaceCityId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.MobileNo, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.MobileNo, new { @class = "form-control", autocomplete = "off", @maxlength = "11" })
                                        @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.PhoneNo, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.NoAutoCompleteTextBoxFor(m => m.PhoneNo, new { @class = "form-control", autocomplete = "off", @maxlength = "11" })
                                        @Html.ValidationMessageFor(m => m.PhoneNo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Email, new { @class = "col-md-3 control-label" })
                                    <div class="col-md-6">
                                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", autocomplete = "off"})
                                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane" id="addresses">

                        </div>
                        <div class="tab-pane" id="partyOwners">
                            @CheckBoxListBuilder.CheckBoxList("partyOwners", ViewBag.PartyOwners)
                        </div>
                    </div>
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="@Url.Action(MVC.Common.Party.ActionNames.Index, MVC.Common.Party.Name)" class="btn btn-danger">
                                <i class="fa fa-lg fa-arrow-right"></i> @GeneralResource.Back
                            </a>
                            <button type="submit" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i>  @GeneralResource.Save
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/kendo/DatePicker/JalaliDate.js"></script>
<script src="~/Scripts/kendo/DatePicker/kendo.web.js"></script>
<script src="~/Scripts/kendo/DatePicker/fa-IR.js"></script>
    <script>
        $(function () {
            warningBeforeLoad();

            $('#ddlBirthPlaceCountry').change(function () {
                $.ajax({
                    url: '@Url.Action(MVC.Common.Party.ActionNames.ChangeCountryComboBox, MVC.Common.Party.Name)',
                    type: 'post',
                    data: { id: $("#ddlBirthPlaceCountry").val() },
                    success: function (data) {
                        $('#ddlBirthPlaceCity').empty();
                        $('#ddlBirthPlaceProvince').empty();
                        jQuery.each(data, function (i) {
                            var option = $('<option></option>').attr("value", data[i].Id).text(data[i].Title);
                            $("#ddlBirthPlaceProvince").append(option);
                        });
                    },
                    error: function (xhr, ajaxOptions, thrownError) {

                    }
                });
            });

            $('#ddlBirthPlaceProvince').change(function () {
                $.ajax({
                    url: '@Url.Action(MVC.Common.Party.ActionNames.ChangeProvinceComboBox, MVC.Common.Party.Name)',
                    type: 'post',
                    data: { id: $("#ddlBirthPlaceProvince").val() },
                    success: function (data) {
                        $('#ddlBirthPlaceCity').empty();
                        jQuery.each(data, function (i) {
                            var option = $('<option></option>').attr("value", data[i].Id).text(data[i].Title);
                            $("#ddlBirthPlaceCity").append(option);
                        });
                    },
                    error: function (xhr, ajaxOptions, thrownError) {

                    }
                });
            });
        });
    </script>
}
