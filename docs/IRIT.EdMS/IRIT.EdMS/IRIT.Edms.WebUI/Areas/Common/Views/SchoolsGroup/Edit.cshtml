@model IRIT.EdMS.Common.Model.ViewModel.SchoolsGroup.SchoolsGroupViewModel

@using IRIT.Framework.Utility.Helpers
@{
    ViewBag.Title = GeneralResource.EditSchoolsGroup;
}

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(MVC.Common.SchoolsGroup.ActionNames.Edit, MVC.Common.SchoolsGroup.Name, new { area = MVC.Common.Name }, FormMethod.Post, new { User = "form", @class = "form-horizontal", autocomplete = "off", id = "createUserForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(c => c.Id)
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>@GeneralResource.Specifications</strong>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.SchoolsGroupName, new { @class = "col-md-5 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.SchoolsGroupName)
                                    @Html.ValidationMessageFor(m => m.SchoolsGroupName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.InfraStructureRingId, new { @class = "col-md-5 control-label" })
                                <div class="col-md-6">
                                    @Html.DropDownListFor(m => m.InfraStructureRingId, (SelectList)ViewBag.InfraStructureRings, string.Empty, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.InfraStructureRingId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.Code, new { @class = "col-md-5 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.Code)
                                    @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.Comment, new { @class = "col-md-5 control-label" })
                                <div class="col-md-6">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.Comment)
                                    @Html.ValidationMessageFor(m => m.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="@Url.Action(MVC.Common.SchoolsGroup.ActionNames.Index, MVC.Common.SchoolsGroup.Name)" class="btn btn-danger">
                                <i class="fa fa-lg fa-arrow-right"></i> @GeneralResource.Back
                            </a>
                            <button type="submit" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i>  @GeneralResource.Save 
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
    </script>}