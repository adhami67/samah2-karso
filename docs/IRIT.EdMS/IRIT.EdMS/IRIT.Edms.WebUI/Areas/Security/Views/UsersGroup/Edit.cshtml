@model IRIT.EdMS.Security.Model.ViewModel.UserGroup.UsersGroupViewModel

@using IRIT.Framework.Utility.Helpers
@{
    ViewBag.Title =GeneralResource.EditSchoolsGroup;
}

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(MVC.Security.UsersGroup.ActionNames.Edit, MVC.Security.UsersGroup.Name, new { area = MVC.Security.Name }, FormMethod.Post, new { User = "form", @class = "form-horizontal", autocomplete = "off", id = "createUserForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(a => a.Id)
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>@GeneralResource.Specifications</strong>
                </div>
                <div class="panel-body">
                    <div class="tab-content">
                        <div class="tab-pane active" style="padding-top:20px;" id="requiredInfo">
                            <div class="form-group">
                                @Html.LabelFor(m => m.GroupName, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.GroupName)
                                    @Html.ValidationMessageFor(m => m.GroupName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.Comment, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.NoAutoCompleteTextBoxFor(m => m.Comment)
                                    @Html.ValidationMessageFor(m => m.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="@Url.Action(MVC.Security.UsersGroup.ActionNames.Index, MVC.Security.UsersGroup.Name)" class="btn btn-danger">
                                <i class="fa fa-lg fa-arrow-right"></i> @GeneralResource.Back
                            </a>
                            <button type="submit" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i>  @GeneralResource.Save
                            </button>                           
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            warningBeforeLoad();
            makeUploadFile("AvatarImage");
        });
    </script>
}




