@model IRIT.EdMS.Security.Model.ViewModel.User.UserViewModel

@using IRIT.EdMS.WebUI.RazorHelpers
@using IRIT.Framework.Utility.Helpers

@{
    ViewBag.Title =GeneralResource.EditUser;
}
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(MVC.Security.User.ActionNames.Edit, MVC.Security.User.Name, new { area = MVC.Security.Name }, FormMethod.Post, new { User = "form", @class = "form-horizontal", autocomplete = "off", id = "editUserForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(a => a.Id)
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>@GeneralResource.Specifications</strong>
                </div>
                <div class="panel-body">
                    <ul class="nav nav-tabs">
                        <li class="active">
                            <a href="#requiredInfo" data-toggle="tab">@GeneralResource.Specifications</a>
                        </li>                       
                        <li>
                            <a href="#permissions" data-toggle="tab">@GeneralResource.Access</a>
                        </li>
                        <li>
                            <a href="#settings" data-toggle="tab">@GeneralResource.UserSettings</a>
                        </li>
                        <li>
                            <a href="#roles" data-toggle="tab">@GeneralResource.UserGroups</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane active" style="padding-top:20px;" id="requiredInfo">                           
                            <div class="form-group">
                                @Html.LabelFor(m => m.UserName, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.NoAutoCompleteTextBoxForLtr(m => m.UserName)
                                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                           
                        </div>
                       
                        <div class="tab-pane" id="permissions">
                                @*@CheckBoxListBuilder.CheckBoxList("PermissionIds", ViewBag.Permissions)*@
                            </div>
                        <div class="tab-pane" id="settings">
                            @*<div class="row">

                                    <div class="col-md-4">
                                        @Html.CheckBoxFor(m => m.IsBanned, new { @class = "checkbox-inline" })
                                        @Html.LabelFor(m => m.IsBanned, new { @class = "control-label" })
                                    </div>
                                    <div class="col-md-4">
                                        @Html.CheckBoxFor(m => m.CanChangeProfilePicture, new { @class = "checkbox-inline" })
                                        @Html.LabelFor(m => m.CanChangeProfilePicture, new { @class = "control-label" })
                                    </div>
                                    <div class="col-md-4">
                                        @Html.CheckBoxFor(m => m.CanUploadFile, new { @class = "checkbox-inline" })
                                        @Html.LabelFor(m => m.CanUploadFile, new { @class = "control-label" })
                                    </div>
                                    <div class="col-md-4">
                                        @Html.CheckBoxFor(m => m.CanModifyFirsAndLastName, new { @class = "checkbox-inline" })
                                        @Html.LabelFor(m => m.CanModifyFirsAndLastName, new { @class = "control-label" })
                                    </div>
                                </div>*@
                        </div>
                        <div class="tab-pane" id="roles">
                            @CheckBoxListBuilder.CheckBoxList("UserGroupIds", ViewBag.UsersGroups)
                        </div>
                    </div>
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="@Url.Action(MVC.Security.User.ActionNames.Index, MVC.Security.User.Name)" class="btn btn-danger">
                                <i class="fa fa-lg fa-arrow-right"></i> @GeneralResource.Back
                            </a>
                            <button type="submit" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i>  @GeneralResource.Save
                            </button>                           
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            warningBeforeLoad();
            makeUploadFile("AvatarImage");
        });
    </script>
}




