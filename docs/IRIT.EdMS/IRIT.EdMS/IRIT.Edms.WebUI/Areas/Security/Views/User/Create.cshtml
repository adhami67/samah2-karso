@model IRIT.EdMS.Security.Model.ViewModel.User.UserViewModel

@using IRIT.Framework.Utility.Helpers
@using IRIT.EdMS.WebUI.RazorHelpers;

@{
    ViewBag.Title = GeneralResource.AddUser;
}
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(MVC.Security.User.ActionNames.Create, MVC.Security.User.Name, new { area = MVC.Security.Name }, FormMethod.Post, new { User = "form", @class = "form-horizontal", autocomplete = "off", id = "createUserForm" }))
        {
            @Html.AntiForgeryToken()
            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>@GeneralResource.Specifications</strong>
                </div>
                <div class="panel-body">
                    <ul class="nav nav-tabs">
                        <li class="active">
                            <a href="#requiredInfo" data-toggle="tab">@GeneralResource.Specifications</a>
                        </li>
                        <li>
                            <a href="#permissions" data-toggle="tab">@GeneralResource.Access</a>
                        </li>
                        <li>
                            <a href="#settings" data-toggle="tab">@GeneralResource.UserSettings</a>
                        </li>
                        <li>
                            <a href="#roles" data-toggle="tab">@GeneralResource.UserGroups</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane active" style="padding-top:20px;" id="requiredInfo">
                            <div class="form-group">
                                @Html.LabelFor(m => m.PartyId, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(m => m.PartyId, (SelectList)ViewBag.Partys, string.Empty, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.PartyId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.UserName, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.NoAutoCompleteTextBoxForLtr(m => m.UserName)
                                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.UserPassword, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.FormControlPasswordFor(m => m.UserPassword)
                                    @Html.ValidationMessageFor(m => m.UserPassword, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.ReUserPassword, new { @class = "col-md-2 control-label" })
                                <div class="col-md-10">
                                    @Html.FormControlPasswordFor(m => m.ReUserPassword)
                                    @Html.ValidationMessageFor(m => m.ReUserPassword, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane" id="permissions">
                            @*@CheckBoxListBuilder.CheckBoxList("PermissionIds", ViewBag.Permissions)*@
                        </div>
                        <div class="tab-pane" id="settings">

                        </div>
                        <div class="tab-pane" id="roles">
                            @CheckBoxListBuilder.CheckBoxList("UserGroupIds", ViewBag.UsersGroups)
                        </div>
                    </div>
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="@Url.Action(MVC.Security.User.ActionNames.Index, MVC.Security.User.Name)" class="btn btn-danger">
                                <i class="fa fa-lg fa-arrow-right"></i> @GeneralResource.Back
                            </a>
                            <button type="submit" value="Create" name="action:Create" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i>  @GeneralResource.Save
                            </button>

                            <button type="submit" value="Create" name="action:Create_new" autocomplete="off" class="btn btn-success">
                                <i class="fa fa-lg fa-save"></i>  @GeneralResource.SaveNew
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {
            warningBeforeLoad();
            makeUploadFile("AvatarImage");
        });
    </script>
}
