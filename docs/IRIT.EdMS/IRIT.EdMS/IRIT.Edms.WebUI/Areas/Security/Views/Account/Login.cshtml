@using CaptchaMvc.HtmlHelpers
@using IRIT.Framework.Utility.Helpers
@model IRIT.EdMS.Security.Model.ViewModel.Account.LoginViewModel

@{
    ViewBag.Title = GeneralResource.SchoolManagementSystem;
    Layout = "~/Views/Shared/_LayoutUnauthorize.cshtml";
}
<style>
    html {
        position: relative;
        min-height: 100%;
    }
    body {
        background: white;
        margin: 50px 0;
    }
    header, footer {
        background: lightseagreen;
        width: 100%;
        height: 50px;
    }
    header {
        position: fixed;
        left: 0;
        top: 0;
    }
    footer {
        position: absolute;
        left: 0;
        bottom: 0;
    }
    .container {
        width: 70%;
        margin: 0 auto;
        background: white;
        min-height: calc(100vh - 100px);
    }
</style>

<div class="row">
    <div class="col-md-5 col-sm-offset-5">
        <img src="~/Content/Image/Icon/in_the_name_of_GOD.gif" width="80" height="80" style="margin-bottom: 30px; margin-right: 100px;"/>
    </div>
</div>
    <div class="row">
        @using (Html.BeginForm(MVC.Security.Account.ActionNames.Login, MVC.Security.Account.Name, new { ViewBag.ReturnUrl, area = MVC.Security.Account.Area }, FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "loginForm", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            <div class="col-md-4 col-sm-offset-4">
                <div class="panel  panel-default">
                    <div class="panel-heading">
                        <strong> ورود به حساب کاربری</strong>
                    </div>
                    <div class="panel-body">
                        <div class="form-group" style="margin-top: 20px;">
                            @Html.LabelFor(m => m.UserName, new { @class = "col-md-3 control-label" })
                            <div class="col-md-8">
                                @Html.NoAutoCompleteTextBoxForLtr(m => m.UserName)
                                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Password, new { @class = "col-md-3 control-label" })
                            <div class="col-md-8">
                                @Html.FormControlPasswordFor(m => m.Password)
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-4 col-md-offset-3">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "checkbox-inline" })
                                @Html.LabelFor(m => m.RememberMe, new { @class = "control-label" })
                            </div>
                        </div>
                        @if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
                        {
                            <div class="alert alert-error" style="background-color: rgb(247, 147, 128);">
                                <button type="button" class="close" data-dismiss="alert">×</button>
                                @Html.ValidationSummary(true, GeneralResource.Error+" ")
                            </div>
                        }
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-md-2">
                                <button type="submit" autocomplete="off" class="btn btn-success" id="btn-login">
                                    <i class="glyphicon glyphicon-log-in"></i> @GeneralResource.Login
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }
