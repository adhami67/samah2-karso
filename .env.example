# Application
APP_NAME=Karso
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./karso.db

# Security
SECRET_KEY=CHANGE_THIS_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Bootstrap Admin
BOOTSTRAP_ADMIN_NATIONAL_ID=0012345678
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000